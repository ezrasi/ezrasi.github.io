{
  "version": 2,
  "rewrites": [
    {
      "source": "/randompiece",
      "destination": "https://randompiece.vercel.app"
    },
    {
      "source": "/randompiece/:path*",
      "destination": "https://randompiece.vercel.app/:path*"
    },
    {
      "source": "/randompiece/api/:path*",
      "destination": "https://randompiece.vercel.app/api/:path*"
    }
  ],
    "headers": [
    {
      "source": "/randompiece/(.*)",
      "headers": [
        {
          "key": "X-Forwarded-Host",
          "value": "ezrasi.vercel.app"
        }
      ]
    }
  ]
}
